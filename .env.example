# --- Buzz relay ---
BUZZ_RELAY_URL=ws://localhost:3000
# nsec of the bot's own Nostr identity. Used to: authenticate via NIP-42,
# publish reply messages, and sign the zap receipts (kind 9735) this bot issues.
# Generate one with: pnpm exec tsx scripts/generate-key.ts (see README)
BUZZ_BOT_NSEC=nsec1...
# NIP-29 channel UUID to listen on for the /zap command (test channel).
BUZZ_CHANNEL_ID=

# --- LaWallet NWC ---
# Base URL of the local `apps/web` instance (docker-compose default port 2288).
LAWALLET_BASE_URL=http://localhost:2288
LAWALLET_VERIFY_POLL_INTERVAL_MS=2000
LAWALLET_VERIFY_TIMEOUT_MS=120000

# --- buzz-zaps ---
DB_PATH=./data/buzz-zaps.sqlite3
TRIGGERS_CONFIG_PATH=./config/triggers.example.yaml
LOG_LEVEL=info
# Relays the zap receipt gets published to, besides BUZZ_RELAY_URL (comma separated).
ZAP_RECEIPT_EXTRA_RELAYS=
