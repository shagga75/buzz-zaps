# --- Bot identity (shared across every community this process serves) ---
# nsec of the bot's own Nostr identity. Used to: authenticate via NIP-42
# against each community's relay connection, publish reply messages, and
# sign the zap receipts (kind 9735) this bot issues.
# Generate one with: pnpm exec tsx scripts/generate-key.ts (see README)
BUZZ_BOT_NSEC=nsec1...

# --- LaWallet NWC polling (shared defaults; per-community wallet URLs live
# in config/communities.yaml, not here — see "Fase 2 — wallets por
# comunidad" in the README) ---
LAWALLET_VERIFY_POLL_INTERVAL_MS=2000
LAWALLET_VERIFY_TIMEOUT_MS=120000

# --- buzz-zaps ---
# Which communities to serve, each with its own relay connection, LaWallet
# instance, and triggers. See config/communities.example.yaml.
COMMUNITIES_CONFIG_PATH=./config/communities.example.yaml
# Base directory for a community's SQLite file when its entry in
# communities.yaml doesn't set its own db_path (defaults to
# `${DB_DIR}/${community-name}.sqlite3`).
DB_DIR=./data
LOG_LEVEL=info
# Relays the zap receipt also gets published to, besides each community's own
# relay_url (comma separated).
ZAP_RECEIPT_EXTRA_RELAYS=
